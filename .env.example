# Configure Pocket ID as a confidential OIDC client.
WATCHBEAT_HOST=watchbeat.example.com
PUBLIC_URL=https://watchbeat.example.com
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
# openssl rand -hex 48
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
WATCHBEAT_PORT=8080
# Optional: Apple developer JWT generated from your MusicKit key (never commit keys).
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=de
